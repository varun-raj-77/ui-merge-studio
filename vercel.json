{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/studio/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/catalogue", "destination": "/showcase-frame.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
